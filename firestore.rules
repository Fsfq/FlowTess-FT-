rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if current user has admin name 'FsFq'
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.player_name == 'FsFq';
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // High Scores Collection
    match /high_scores/{userId} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Player Presence
    match /presence/{userId} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Lobby General Chat
    match /lobby_chat/{msgId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Lobby Rooms
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if request.auth != null;
      
      match /chat/{msgId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
