rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════
    // 🛡️ ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ БЕЗОПАСНОСТИ
    // ════════════════════════════════════════════════

    function isVerifiedUser() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'ge9Lzx5EkCfbINDZEG6I8vYcJCd2' ||
        (request.auth.token.email != null && request.auth.token.email_verified == true && request.auth.token.email == 'ezik02021@gmail.com')
      );
    }

    function isBanned() {
      return resource != null && 'is_banned' in resource.data && resource.data.is_banned == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid && !isBanned();
    }

    function isValidScore(score) {
      return score is int && score >= 0 && score <= 100000000;
    }

    // ════════════════════════════════════════════════
    // 🧑 USERS — профиль игрока и социальные подколлекции
    // ════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if true;
      allow create: if (isOwner(userId)
                        && (!('is_admin' in request.resource.data) || request.resource.data.is_admin != true)
                        && (!('player_name' in request.resource.data) || !request.resource.data.player_name.matches('.*(?i)(fsfq|admin|administrator).*'))
                        && (!('app_version_code' in request.resource.data) || request.resource.data.app_version_code >= 15)
                        && (!('credits' in request.resource.data) || (
                              request.resource.data.credits is int &&
                              request.resource.data.credits >= 0 &&
                              request.resource.data.credits <= 5000000
                           ))
                       ) || isAdmin();
      allow update: if (isOwner(userId)
                        && (!('is_admin' in request.resource.data) || request.resource.data.is_admin != true)
                        && (!('is_banned' in request.resource.data) || request.resource.data.is_banned == resource.data.is_banned)
                        && (!('player_name' in request.resource.data) || !request.resource.data.player_name.matches('.*(?i)(fsfq|admin|administrator).*'))
                        && (!('app_version_code' in request.resource.data) || (
                              request.resource.data.app_version_code >= 15 &&
                              (!('app_version_code' in resource.data) || request.resource.data.app_version_code >= resource.data.app_version_code)
                           ))
                        && (!('credits' in request.resource.data) || (
                              request.resource.data.credits is int &&
                              request.resource.data.credits >= 0 &&
                              (!('credits' in resource.data) || request.resource.data.credits - resource.data.credits <= 50000)
                           ))
                       ) || isAdmin();
      allow delete: if isAdmin();

      // Подколлекция друзей: users/{userId}/friends/{friendId}
      match /friends/{friendId} {
        allow read: if isOwner(userId) || (isVerifiedUser() && request.auth.uid == friendId) || isAdmin();
        allow create, update, delete: if (!isBanned() && isVerifiedUser() && (request.auth.uid == userId || request.auth.uid == friendId)) || isAdmin();
      }
    }

    // ════════════════════════════════════════════════
    // 🏆 HIGH_SCORES — глобальный лидерборд
    // ════════════════════════════════════════════════
    match /high_scores/{scoreId} {
      allow read: if true;

      allow create: if isOwner(scoreId)
                    && request.resource.data.keys().hasAll(['uid', 'playerName', 'timestamp'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.playerName is string
                    && request.resource.data.playerName.size() >= 1
                    && (!request.resource.data.playerName.matches('.*(?i)(fsfq|admin|administrator).*') || isAdmin())
                    && (!('score' in request.resource.data) || isValidScore(request.resource.data.score))
                    && (!('app_version_code' in request.resource.data) || request.resource.data.app_version_code >= 15);

      allow update: if (isOwner(scoreId)
                    && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
                    && (!('playerName' in request.resource.data) || !request.resource.data.playerName.matches('.*(?i)(fsfq|admin|administrator).*') || isAdmin())
                    && (!('score' in request.resource.data) || isValidScore(request.resource.data.score))
                    && (!('app_version_code' in request.resource.data) || (
                          request.resource.data.app_version_code >= 15 &&
                          (!('app_version_code' in resource.data) || request.resource.data.app_version_code >= resource.data.app_version_code)
                       )))
                    || isAdmin();

      allow delete: if isOwner(scoreId) || isAdmin();
    }

    // 🏆 Рекорды по отдельным режимам игры
    match /high_scores_by_mode/{modeId}/scores/{scoreId} {
      allow read: if true;
      
      allow create: if isOwner(scoreId)
                    && request.resource.data.keys().hasAll(['uid', 'playerName', 'timestamp'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.playerName is string
                    && request.resource.data.playerName.size() >= 1
                    && (!request.resource.data.playerName.matches('.*(?i)(fsfq|admin|administrator).*') || isAdmin())
                    && (!('score' in request.resource.data) || isValidScore(request.resource.data.score));

      allow update: if (isOwner(scoreId)
                    && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
                    && (!('playerName' in request.resource.data) || !request.resource.data.playerName.matches('.*(?i)(fsfq|admin|administrator).*') || isAdmin())
                    && (!('score' in request.resource.data) || isValidScore(request.resource.data.score)))
                    || isAdmin();

      allow delete: if isOwner(scoreId) || isAdmin();
    }

    // 🟢 PRESENCE — онлайн-статус пользователей
    match /presence/{presenceId} {
      allow read: if true;
      
      allow create, update: if isOwner(presenceId)
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.keys().hasAll(['uid', 'username', 'lastActive']);

      allow delete: if isOwner(presenceId) || isAdmin();
    }

    // 💬 LOBBY_CHAT — общий чат
    match /lobby_chat/{messageId} {
      allow read: if true;
      
      allow create: if (isVerifiedUser()
                    && !isBanned()
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 500)
                    || isAdmin();

      allow update: if false;
      allow delete: if isAdmin();
    }

    // 🎮 ROOMS — сетевые комнаты и дуэли
    match /rooms/{roomId} {
      allow read: if true;
      
      allow create: if (isVerifiedUser()
                    && !isBanned()
                    && request.resource.data.hostId == request.auth.uid
                    && request.resource.data.status == 'waiting')
                    || isAdmin();

      allow update: if (isVerifiedUser() && !isBanned()) || isAdmin();
      
      allow delete: if (isVerifiedUser() && resource.data.hostId == request.auth.uid) || isAdmin();

      match /chat/{chatMsgId} {
        allow read: if true;
        
        allow create: if (isVerifiedUser()
                      && !isBanned()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 500)
                      || isAdmin();

        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // 📢 GLOBAL_ANNOUNCEMENTS & BROADCASTS — глобальные системные оповещения
    match /global_announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /global_broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 📢 SYSTEM_CONFIG — системные настройки сервера
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 🏷️ NICKNAMES — уникальная привязка никнейма к аккаунту и почте
    match /nicknames/{nickLower} {
      allow read: if true;
      allow create: if isVerifiedUser()
                    && (!nickLower.matches('.*(?i)(fsfq|admin|administrator).*') || isAdmin())
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.nick_lower == nickLower;
      allow update: if isVerifiedUser()
                    && (resource.data.uid == request.auth.uid || isAdmin())
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if isVerifiedUser()
                    && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Запрет на любые другие коллекции
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
