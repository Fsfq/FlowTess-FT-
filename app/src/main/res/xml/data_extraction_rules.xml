<?xml version="1.0" encoding="utf-8"?>
<!--
  Правила извлечения данных (Android 12+).
  Запрещаем резервное копирование и перенос чувствительных данных:
  SharedPreferences (содержит игровую валюту, тир, пароли-хеши) и БД
  (учётные записи с хешами паролей). Даже при allowBackup эти домены
  исключены из cloud-backup и device-transfer, чтобы данные не утекали.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tetris_prefs.xml" />
        <exclude domain="sharedpref" path="block_tetris_prefs.xml" />
        <exclude domain="database" path="tetris-db" />
        <exclude domain="database" path="tetris-db-journal" />
        <exclude domain="database" path="tetris-db-wal" />
        <exclude domain="database" path="tetris-db-shm" />
        <exclude domain="file" path="custom_avatar_" />
        <exclude domain="file" path="custom_background_" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tetris_prefs.xml" />
        <exclude domain="sharedpref" path="block_tetris_prefs.xml" />
        <exclude domain="database" path="tetris-db" />
        <exclude domain="database" path="tetris-db-journal" />
        <exclude domain="database" path="tetris-db-wal" />
        <exclude domain="database" path="tetris-db-shm" />
        <exclude domain="file" path="custom_avatar_" />
        <exclude domain="file" path="custom_background_" />
    </device-transfer>
</data-extraction-rules>
