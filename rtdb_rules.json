{
  "rules": {

    // ════════════════════════════════════════════
    // Глобальный доступ — только администратор
    // UID: ge9Lzx5EkCfbINDZEG6I8vYcJCd2
    // ════════════════════════════════════════════
    ".read":  "auth !== null && (auth.uid === 'ge9Lzx5EkCfbINDZEG6I8vYcJCd2' || (auth.token.email != null && (auth.token.email === 'ezik02021@gmail.com' || auth.token.email === 'eziko04@gmail.com')))",
    ".write": "auth !== null && (auth.uid === 'ge9Lzx5EkCfbINDZEG6I8vYcJCd2' || (auth.token.email != null && (auth.token.email === 'ezik02021@gmail.com' || auth.token.email === 'eziko04@gmail.com')))",

    // ════════════════════════════════════════════
    // 1. USERS — профили игроков
    // ════════════════════════════════════════════
    "users": {
      "$uid": {
        // Читать профиль — любой авторизованный
        ".read": "auth !== null",

        // Писать: сам пользователь или администратор
        ".write": "auth !== null && (auth.uid === $uid || (auth.uid === 'ge9Lzx5EkCfbINDZEG6I8vYcJCd2' || (auth.token.email != null && (auth.token.email === 'ezik02021@gmail.com' || auth.token.email === 'eziko04@gmail.com'))))",

        // Обязательные поля при регистрации
        ".validate": "newData.hasChildren(['player_name', 'credits', 'online_tier', 'bonus_xp', 'has_nickname_gradient'])",

        "player_name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24"
        },

        // Античит: кредиты не могут быть отрицательными
        // За одну запись нельзя прибавить более 100 000 (только не-Admin)
        "credits": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000 && ((auth.uid === 'ge9Lzx5EkCfbINDZEG6I8vYcJCd2' || (auth.token.email != null && (auth.token.email === 'ezik02021@gmail.com' || auth.token.email === 'eziko04@gmail.com'))) || data.val() === null || newData.val() - data.val() <= 100000)"
        },

        // Античит: только разрешённые тиры
        "online_tier": {
          ".validate": "newData.isString() && ((auth.uid === 'ge9Lzx5EkCfbINDZEG6I8vYcJCd2' || (auth.token.email != null && (auth.token.email === 'ezik02021@gmail.com' || auth.token.email === 'eziko04@gmail.com'))) || newData.val() === 'BRONZE' || newData.val() === 'SILVER' || newData.val() === 'GOLD' || newData.val() === 'PLATINUM' || newData.val() === 'DIAMOND' || newData.val() === 'PRO BRONZE' || newData.val() === 'PRO SILVER' || newData.val() === 'PRO GOLD' || newData.val() === 'PRO PLATINUM' || newData.val() === 'PRO DIAMOND' || newData.val() === 'MASTER' || newData.val() === 'GRANDMASTER' || newData.val() === 'LEGEND')"
        },

        // XP не отрицательный, не безграничный
        "bonus_xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && ((auth.uid === 'ge9Lzx5EkCfbINDZEG6I8vYcJCd2' || (auth.token.email != null && (auth.token.email === 'ezik02021@gmail.com' || auth.token.email === 'eziko04@gmail.com'))) || newData.val() <= 50000000)"
        },

        "prestige_level": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 3)"
        },

        "has_nickname_gradient": {
          ".validate": "newData.isBoolean()"
        },

        // Аватар base64 — не более 200 КБ (строка)
        "custom_avatar_base64": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 204800)"
        },

        // Фон base64 — не более 300 КБ
        "custom_background_base64": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 307200)"
        },

        "custom_avatar_emoji": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 8)"
        },

        "custom_avatar_bg_color": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length === 6)"
        },

        "equipped_avatar_frame": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "purchased_avatar_frames": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "equipped_title": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "purchased_titles": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "equipped_sound_pack": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "purchased_sound_packs": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "purchased_themes": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "purchased_fonts": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "purchased_control_button_styles": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "purchased_cube_skins": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "case_inventory": {
          ".validate": "!newData.exists() || newData.isString() || newData.hasChildren()"
        },
        "purchased_modes": {
          ".validate": "!newData.exists() || newData.isString() || newData.hasChildren()"
        },
        "purchased_ranks": {
          ".validate": "!newData.exists() || newData.isString() || newData.hasChildren()"
        },
        "crate_keys": {
          ".validate": "!newData.exists() || newData.hasChildren()"
        },
        "board_color_skin": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "block_style": {
          ".validate": "!newData.exists() || newData.isString()"
        },

        // Статистика — только числа >= 0
        "stats_games_played":     { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "stats_cleared_lines":    { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "stats_high_score":       { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000)" },
        "stats_max_speed_reached":{ ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 30)" },
        "stats_tetrises_count":   { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "stats_spent_credits":    { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "stats_avatar_changes":   { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "block_blast_high_score": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000)" },
        "multiplayer_launches":   { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "stats_pattern_level":    { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "stats_pattern_score":    { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000)" },
        "stats_sculptor_level":   { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "stats_sculptor_score":   { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000)" },
        "custom_tag": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 32)"
        },
        "custom_tag_unlocked": {
          ".validate": "!newData.exists() || newData.isBoolean()"
        },
        "is_banned": {
          ".validate": "!newData.exists() || newData.isBoolean()"
        },

        // Любое другое поле — запрещено (защита от вставки произвольных данных)
        "$other": { ".validate": false }
      }
    },

    // ════════════════════════════════════════════
    // 2. HIGH_SCORES — глобальный лидерборд
    // ════════════════════════════════════════════
    "high_scores": {
      // Читать лидерборд — все авторизованные
      ".read": "auth !== null",

      "$uid": {
        // Писать только свой рекорд или администратор
        ".write": "auth !== null && (auth.uid === $uid || (auth.uid === 'ge9Lzx5EkCfbINDZEG6I8vYcJCd2' || (auth.token.email != null && (auth.token.email === 'ezik02021@gmail.com' || auth.token.email === 'eziko04@gmail.com'))))",

        ".validate": "newData.hasChildren(['playerName', 'score', 'timestamp'])",

        "playerName": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24"
        },

        // Anti-cheat: score must be between 0 and 9,999,999
        // Increase per session max 500,000
        "score": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999999 && ((auth.uid === 'ge9Lzx5EkCfbINDZEG6I8vYcJCd2' || (auth.token.email != null && (auth.token.email === 'ezik02021@gmail.com' || auth.token.email === 'eziko04@gmail.com'))) || data.val() === null || newData.val() - data.val() <= 500000)"
        },

        "timestamp": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },

        "hasGradient": {
          ".validate": "!newData.exists() || newData.isBoolean()"
        },
        "customTag": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 6)"
        },
        "$other": { ".validate": false }
      }
    },

    // ════════════════════════════════════════════
    // 2.2. HIGH_SCORES_BY_MODE — глобальные рекорды по режимам
    // ════════════════════════════════════════════
    "high_scores_by_mode": {
      ".read": "auth !== null",
      "$modeId": {
        "scores": {
          "$uid": {
            ".write": "auth !== null && (auth.uid === $uid || (auth.uid === 'ge9Lzx5EkCfbINDZEG6I8vYcJCd2' || (auth.token.email != null && (auth.token.email === 'ezik02021@gmail.com' || auth.token.email === 'eziko04@gmail.com'))))",
            ".validate": "newData.hasChildren(['playerName', 'score', 'timestamp'])",
            "playerName": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24" },
            "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999999" },
            "timestamp": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "mode": { ".validate": "!newData.exists() || newData.isString()" },
            "hasGradient": { ".validate": "!newData.exists() || newData.isBoolean()" },
            "customTag": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 6)" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    // ════════════════════════════════════════════
    // 3. PRESENCE — онлайн-статус (heartbeat)
    // ════════════════════════════════════════════
    "presence": {
      // Видеть кто онлайн — все авторизованные
      ".read": "auth !== null",

      "$uid": {
        // Писать только свой статус или администратор (для очистки)
        ".write": "auth !== null && (auth.uid === $uid || (auth.uid === 'ge9Lzx5EkCfbINDZEG6I8vYcJCd2' || (auth.token.email != null && (auth.token.email === 'ezik02021@gmail.com' || auth.token.email === 'eziko04@gmail.com'))))",

        ".validate": "!newData.exists() || newData.hasChildren(['uid', 'lastActive'])",

        "playerName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length >= 1 && newData.val().length <= 32)" },
        "username":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length >= 1 && newData.val().length <= 32)" },
        "uid":        { ".validate": "newData.isString() && newData.val() === $uid" },
        "lastActive": { ".validate": "newData.isNumber()" },
        "status":     { ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'in_lobby' || newData.val() === 'in_room'))" },
        "tier":       { ".validate": "!newData.exists() || newData.isString()" },
        "hasGradient":{ ".validate": "!newData.exists() || newData.isBoolean()" },
        "credits":    { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },

        "$other": { ".validate": false }
      }
    },

    // ════════════════════════════════════════════
    // 3.5. INVITES — приглашения в комнату
    // ════════════════════════════════════════════
    "invites": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "auth !== null"
      }
    },

    // ════════════════════════════════════════════
    // 4. LOBBY_CHAT — общий чат лобби
    // ════════════════════════════════════════════
    "lobby_chat": {
      // Читать чат — все авторизованные
      ".read": "auth !== null",

      "$msgId": {
        // Создать новое сообщение — любой авторизованный
        // Удалить/изменить — только администратор
        ".write": "auth !== null && ((!data.exists() && newData.exists()) || (auth.uid === 'ge9Lzx5EkCfbINDZEG6I8vYcJCd2' || (auth.token.email != null && (auth.token.email === 'ezik02021@gmail.com' || auth.token.email === 'eziko04@gmail.com'))))",

        ".validate": "newData.hasChildren(['senderName', 'senderId', 'text', 'timestamp'])",

        "senderName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
        },
        // Отправитель должен совпадать с авторизованным uid
        "senderId": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "hasGradient": {
          ".validate": "!newData.exists() || newData.isBoolean()"
        },
        "reactions": {
          ".validate": "!newData.exists() || newData.hasChildren()"
        },

        "$other": { ".validate": false }
      }
    },

    // ════════════════════════════════════════════
    // 5. ROOMS — мультиплеерные комнаты
    // ════════════════════════════════════════════
    "rooms": {
      // Видеть список комнат — все авторизованные
      ".read": "auth !== null",

      "$roomId": {
        // Создать комнату — любой авторизованный
        // Обновить — только хост или участник (оба uid в players) или администратор
        // Удалить — хост или администратор
        ".write": "auth !== null && (!data.exists() || data.child('hostId').val() === auth.uid || data.child('players').child(auth.uid).exists() || (auth.uid === 'ge9Lzx5EkCfbINDZEG6I8vYcJCd2' || (auth.token.email != null && (auth.token.email === 'ezik02021@gmail.com' || auth.token.email === 'eziko04@gmail.com'))))",

        ".validate": "!newData.exists() || newData.hasChildren(['roomId', 'name', 'hostId', 'hostName', 'players', 'status'])",

        "roomId":   { ".validate": "!newData.exists() || newData.val() === $roomId" },
        "name":     { ".validate": "!newData.exists() || (newData.isString() && newData.val().length >= 1 && newData.val().length <= 30)" },
        "hostId":   { ".validate": "!newData.exists() || newData.isString()" },
        "hostName": { ".validate": "!newData.exists() || newData.isString()" },
        "status":   { ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished'))" },
        "password": { ".validate": "!newData.exists() || newData.isString()" },
        "isLocked": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "createdAt":{ ".validate": "!newData.exists() || newData.isNumber()" },
        "winnerId": { ".validate": "!newData.exists() || newData.isString()" },

        // Игровые данные (grid, score, combo)
        "hostGrid":             { ".validate": "!newData.exists() || newData.isString()" },
        "opponentGrid":         { ".validate": "!newData.exists() || newData.isString()" },
        "hostScore":            { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "opponentScore":        { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "hostCombo":            { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "opponentCombo":        { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "hostGameOver":         { ".validate": "!newData.exists() || newData.isBoolean()" },
        "opponentGameOver":     { ".validate": "!newData.exists() || newData.isBoolean()" },
        "hostGarbageToSend":    { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 20)" },
        "opponentGarbageToSend":{ ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 20)" },

        "players": { ".validate": "newData.exists()" },

        "live": {
          ".read": "auth !== null",
          ".write": "auth !== null"
        },

        // ═══ Чат внутри комнаты ═══
        "chat": {
          ".read": "auth !== null",
          ".indexOn": ["timestamp"],
          "$chatMsgId": {
            ".write": "auth !== null",
            ".validate": "newData.hasChildren(['senderName', 'senderId', 'text', 'timestamp'])",
            "senderName": { ".validate": "newData.isString()" },
            "senderId":   { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "text":       { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300" },
            "timestamp":  { ".validate": "newData.isNumber()" },
            "hasGradient":{ ".validate": "!newData.exists() || newData.isBoolean()" },
            "reactions":  { ".validate": "!newData.exists() || newData.hasChildren()" },
            "$other":     { ".validate": false }
          }
        }
      }
    }
  }
}
